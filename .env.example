# Copy this file to .env and fill in real values. Never commit .env.

# Secret used to sign JWTs. Use a long, random string (e.g. `openssl rand -hex 32`).
JWT_SECRET=replace-me-with-a-long-random-secret

# Port the HTTP server listens on.
PORT=3000

# Origin allowed to make browser (CORS) requests to this API.
FRONTEND_ORIGIN=http://localhost:5173

# Turso / libSQL database connection (see README for how to create a free DB).
# For a hosted Turso database, this looks like: libsql://your-db-name-you.turso.io
# For local development you can point at a file instead, e.g. file:local.db
TURSO_DATABASE_URL=libsql://your-database-name.turso.io

# Auth token for the Turso database. Required for hosted (libsql://) databases;
# leave blank when using a local file: URL.
TURSO_AUTH_TOKEN=your-turso-auth-token
