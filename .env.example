# Copy this file to .env and fill in real values. Never commit .env.

# Secret used to sign JWTs. Use a long, random string (e.g. `openssl rand -hex 32`).
JWT_SECRET=replace-me-with-a-long-random-secret

# Port the HTTP server listens on.
PORT=3000

# Origin allowed to make browser (CORS) requests to this API.
FRONTEND_ORIGIN=http://localhost:5173

# Path to the SQLite database file (optional; defaults to ./data/watchlist.db).
DATABASE_PATH=./data/watchlist.db
